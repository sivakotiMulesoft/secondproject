<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config" doc:id="ee4851a4-b403-496b-9d95-27b7db3f16f7" >
		<http:listener-connection host="localhost" port="8081" />
	</http:listener-config>
	<flow name="scatter-gatherFlow" doc:id="1f555027-e2a2-4717-9cac-97b7f6c6e59d" >
		<http:listener doc:name="Listener" doc:id="8b81b972-8e42-4145-9b5f-aa7a77c248ff" config-ref="HTTP_Listener_config" path="/scatter-gather"/>
		<logger level="INFO" doc:name="Logger" doc:id="c0fc496c-e34f-49c3-bb73-d3c37ebed49d" message="#[payload]"/>
		<set-payload value="#[payload]" doc:name="Set Payload" doc:id="c282e8a3-c76a-4f6f-b3d6-318f59a2906d" />
		<set-payload value='#[{"message": "setpayload before scatter-gather"}]' doc:name="Set Payload" doc:id="da2bfb6d-693e-413b-ad06-bd0d794c58a5" />
		<logger level="INFO" doc:name="Logger" doc:id="149cd6f5-4341-49cb-8cb1-62a403d3246e" message="#[payload]"/>
		<scatter-gather doc:name="Scatter-Gather" doc:id="057da6e8-d9e7-4402-a449-85dba03afdd8" >
			<route >
				<logger level="INFO" doc:name="Logger" doc:id="c38d7cf8-a927-4a11-928e-765651efbbe7" message="**route1-target1**"/>
				<logger level="INFO" doc:name="Logger" doc:id="43f47c9e-2472-4984-9fd2-e214e1846395" message="**after route1**"/>
				<set-payload value='#[{"message":"payload after scatter gather logger1"}]' doc:name="Set Payload" doc:id="dbc43cec-72cd-4709-960d-ddc7e0562a28" />
			</route>
			<route >
				<logger level="INFO" doc:name="Logger" doc:id="1329a4c8-0f51-40fb-a390-27426bc5a05b" message="**route1-target2**"/>
				<logger level="INFO" doc:name="Logger" doc:id="4a0a66d0-f13a-4e75-8e34-4ce3f2f95cef" message="**after route2**"/>
				<set-payload value='#[{"message":"payload after scatter gather logger2"}]' doc:name="Set Payload" doc:id="3b36c2b8-1951-437b-a161-b03e197c00e2" />
			</route>
		</scatter-gather>
		<logger level="INFO" doc:name="Logger" doc:id="f61ea8f3-5811-4f61-bd79-5855f74140eb" message="#[payload]"/>
	</flow>
</mule>
